# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# IDE / editor
.idea/
*.iml
.vscode/*
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Node / frontend build
dist/*
node_modules/*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/*

# Tauri updater private keys must never be committed
*.key
!*.key.pub
.env
.env.*

# Android signing material
*.jks
*.keystore

# Android Studio / Gradle local state (keep gen/android project files)
src-tauri/gen/android/local.properties
src-tauri/gen/android/.gradle/
src-tauri/gen/android/.idea/
src-tauri/gen/android/.cxx/
src-tauri/gen/android/captures/
src-tauri/gen/android/**/build/
src-tauri/gen/android/app/src/main/assets/
src-tauri/gen/android/*.iml
src-tauri/gen/android/**/*.iml
