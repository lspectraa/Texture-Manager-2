{
  "identifier": "mobile-capability",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://www.youtube.com/*" },
        { "url": "https://youtube.com/*" },
        { "url": "https://discord.gg/*" },
        { "url": "https://discord.com/*" },
        { "url": "https://*.discord.com/*" }
      ]
    }
  ]
}
