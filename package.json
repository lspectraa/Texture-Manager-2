{
  "name": "texture-manager-2",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Geometry Dash texture tooling remake",
  "author": "Spectra",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lspectraa/Texture-Manager-2.git"
  },
  "homepage": "https://github.com/lspectraa/Texture-Manager-2",
  "bugs": {
    "url": "https://github.com/lspectraa/Texture-Manager-2/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node ./scripts/fetch-upscaler-binaries.mjs --if-missing && tauri",
    "check:env": "node ./scripts/check-prereqs.mjs",
    "phase0:verify": "npm run check:env && npm run build",
    "sync:version": "node ./scripts/sync-version.mjs",
    "fetch:upscaler-binaries": "node ./scripts/fetch-upscaler-binaries.mjs",
    "generate:android-icons": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate_android_icons --features icon-gen",
    "setup:updater-signing": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-updater-signing.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "android:init": "tauri android init",
    "android:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/android-dev.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
